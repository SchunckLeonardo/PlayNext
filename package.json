{
  "name": "playnext",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/local.mjs up",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "security:sca": "npm run verify:vendor && npm audit --audit-level=high",
    "local:up": "node scripts/local.mjs up",
    "local:down": "node scripts/local.mjs down",
    "local:status": "node scripts/local.mjs status",
    "local:test": "node scripts/local-smoke.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
